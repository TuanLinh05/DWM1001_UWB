/ {
	aliases {
		/* D9: green user LED on DWM1001-DEV, active-low (nRF P0.30). */
		status-led = &led1_green;
		/* D8 red: radio/platform fault. */
		fault-led = &led0_red;
		/* D11 blue: valid host command received (GUI heartbeat). */
		host-led = &led3_blue;
	};
};

/*
 * The application talks to the internal DW1000 through SPI2.  SPI1 only goes
 * to the DWM1001-DEV Raspberry Pi header and is unused by this TAG firmware.
 * Disable it so the external header pins remain quiescent during bring-up.
 */
&spi1 {
	status = "disabled";
};

/*
 * UART0 uses P0.05/P0.11.  With factory-default solder bridges J14/J15 closed,
 * it is exposed as the on-board J-Link USB Virtual COM port.
 *
 * RANGE_MEAS sends one 66-byte frame per measurement (about 300-400 per
 * second with eight anchors) next to the 50 Hz snapshots: ~30 kB/s, which is
 * far beyond 115200 baud (11.5 kB/s). Use the EasyDMA UARTE at 1 Mbaud, as
 * Sniffer_DevKit does on the same board: the nRF52 generates exactly
 * 1000000 baud (its "921600" setting really runs at 941176), and the J-Link
 * virtual COM port supports it. The GUI and uwb_command.py default to it.
 */
&uart0 {
	compatible = "nordic,nrf-uarte";
	current-speed = <1000000>;
	status = "okay";
};
