{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "DWM1001C: Build Tag",
      "type": "process",
      "command": "powershell.exe",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-Command",
        "& '${workspaceFolder}\\scripts\\build.ps1'"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": []
    },
    {
      "label": "DWM1001C: Check ST-LINK SWD",
      "type": "process",
      "command": "${config:dwm1001.openocdPath}",
      "args": [
        "-s",
        "${config:dwm1001.openocdScripts}",
        "-f",
        "${workspaceFolder}/.vscode/openocd-stlink.cfg",
        "-c",
        "init",
        "-c",
        "reset halt",
        "-c",
        "exit"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    },
    {
      "label": "DWM1001C: Flash Tag via ST-LINK",
      "type": "process",
      "command": "${config:dwm1001.openocdPath}",
      "args": [
        "-s",
        "${config:dwm1001.openocdScripts}",
        "-f",
        "${workspaceFolder}/.vscode/openocd-stlink.cfg",
        "-c",
        "program {${workspaceFolder}/build/zephyr/zephyr.hex} verify reset exit"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    }
  ]
}
